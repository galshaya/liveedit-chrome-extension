{
  "manifest_version": 3,
  "name": "LiveEdit - Real-time Website Editor",
  "version": "1.0.0",
  "description": "Edit any website's content in real-time with instant preview and undo functionality",
  
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "notifications",
    "downloads",
    "contextMenus"
  ],
  
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "LiveEdit - Toggle edit mode",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["utils/dom-utils.js", "utils/storage-utils.js", "content/content.js"],
      "css": ["content/styles.css"],
      "run_at": "document_end"
    }
  ],
  
  "web_accessible_resources": [
    {
      "resources": ["content/editor.js", "content/styles.css"],
      "matches": ["<all_urls>"]
    }
  ],
  
  "commands": {
    "toggle-edit-mode": {
      "suggested_key": {
        "default": "Ctrl+Shift+E",
        "mac": "Command+Shift+E"
      },
      "description": "Toggle LiveEdit mode on/off"
    }
  },
  
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}